      "id": 5,
      "title": "HTTP traffic / second",
      "type": "timeseries",
      "targets": [{"expr": "sum by (deployment_environment_name, service_version) (rate(http_server_request_duration_seconds_count{deployment_environment_name=~\"$environment\",service_version=~\"$version\"}[5m]))", "legendFormat": "{{deployment_environment_name}} {{service_version}}"}]
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "id": 6,
      "title": "HTTP 5xx errors / second",
      "type": "timeseries",
      "targets": [{"expr": "sum by (deployment_environment_name, service_version) (rate(http_server_request_duration_seconds_count{deployment_environment_name=~\"$environment\",service_version=~\"$version\",http_response_status_code=~\"5..\"}[5m]))", "legendFormat": "{{deployment_environment_name}} {{service_version}}"}]
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24},
      "id": 7,
      "title": "HTTP request p95",
      "type": "timeseries",
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le, deployment_environment_name, service_version) (rate(http_server_request_duration_seconds_bucket{deployment_environment_name=~\"$environment\",service_version=~\"$version\"}[5m])))", "legendFormat": "{{deployment_environment_name}} {{service_version}}"}]
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24},
      "id": 8,
      "title": "Application operation errors / second",
      "type": "timeseries",
      "targets": [{"expr": "sum by (operation, deployment_environment_name, service_version) (rate(paircode_operation_errors_total{deployment_environment_name=~\"$environment\",service_version=~\"$version\"}[5m]))", "legendFormat": "{{operation}} {{deployment_environment_name}}"}]
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
