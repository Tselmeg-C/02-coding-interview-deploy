      "id": 9,
      "title": "Health endpoint traffic",
      "type": "timeseries",
      "targets": [{"expr": "sum by (deployment_environment_name, service_version) (rate(http_server_request_duration_seconds_count{deployment_environment_name=~\"$environment\",service_version=~\"$version\",http_route=\"/health\"}[5m]))", "legendFormat": "{{deployment_environment_name}} {{service_version}}"}]
    }
  ],
  "schemaVersion": 39,
  "templating": {
    "list": [
      {"name": "environment", "type": "query", "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "query": "label_values({__name__=~\"paircode_.*|http_server_request_duration_seconds.*\"}, deployment_environment_name)", "includeAll": true, "multi": true, "current": {"text": "All", "value": ["$__all"]}},
      {"name": "version", "type": "query", "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "query": "label_values({__name__=~\"paircode_.*|http_server_request_duration_seconds.*\"}, service_version)", "includeAll": true, "multi": true, "current": {"text": "All", "value": ["$__all"]}}
    ]
  },
  "title": "PairCode Interview overview",
  "uid": "paircode-overview",
  "version": 1
}
