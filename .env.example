# Default: SQLite database relative to backend/
# DATABASE_URL=sqlite:./data/coding-interview.sqlite3

# PostgreSQL alternative (DATABASE_URL takes precedence when set)
# DB_ENGINE=postgresql
# DB_NAME=coding_interview
# DB_USER=postgres
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# Docker Compose starts a local Postgres instance using trust authentication.
# Do not use this local-only setup for a public deployment. Railway should use
# its managed PostgreSQL service and inject DATABASE_URL into the app service.
DEPLOYMENT_ENVIRONMENT=development
SERVICE_VERSION=local
# Set an OTLP endpoint and credentials in the deployment environment, never here.
# OTEL_EXPORTER_OTLP_ENDPOINT=https://telemetry.example.invalid
# OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer%20REDACTED
OTEL_SERVICE_NAME=paircode-interview
# Local default: keep exporters disabled. Enable all three in Railway.
OTEL_TRACES_EXPORTER=none
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none
# OTEL_TRACES_EXPORTER=otlp
# OTEL_METRICS_EXPORTER=otlp
# OTEL_LOGS_EXPORTER=otlp
