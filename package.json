{
  "name": "coding-interview",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev --prefix backend\" \"npm run dev --prefix frontend\"",
    "test": "npm run test --prefix backend && npm run test --prefix frontend",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "compose:up": "docker compose up --build --wait",
    "compose:down": "docker compose down --volumes --remove-orphans",
    "test:integration": "node integration/compose-smoke.mjs",
    "test:backup-restore": "bash scripts/postgres-restore-smoke.sh",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "concurrently": "^9.2.1",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "typescript": "^7.0.2"
  }
}
